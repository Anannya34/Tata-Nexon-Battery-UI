# Battery RUL Prediction System - Environment Configuration
# Copy this file to .env and update the values

# Application Settings
APP_NAME="Battery RUL Prediction System"
VERSION="2.0.0"
ENVIRONMENT=development
DEBUG=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
DASHBOARD_PORT=8501

# Security Settings
SECRET_KEY=your-super-secret-key-change-in-production-make-it-very-long-and-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# CORS Settings (comma-separated)
ALLOW_ORIGINS=http://localhost:3000,http://localhost:8501
ALLOW_CREDENTIALS=true
ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Machine Learning Parameters
BATCH_SIZE=32
LEARNING_RATE=0.001
NUM_EPOCHS=100
EARLY_STOPPING_PATIENCE=10
VALIDATION_SPLIT=0.2
RANDOM_SEED=42

# LSTM Configuration
LSTM_HIDDEN_SIZE=128
LSTM_NUM_LAYERS=2
LSTM_DROPOUT=0.2

# Transformer Configuration
TRANSFORMER_D_MODEL=256
TRANSFORMER_NHEAD=8
TRANSFORMER_NUM_LAYERS=6
TRANSFORMER_DROPOUT=0.1

# Prediction Parameters
SEQUENCE_LENGTH=50
PREDICTION_HORIZON=10
CONFIDENCE_INTERVAL=0.95

# Health Thresholds
RUL_CRITICAL_THRESHOLD=150
RUL_WARNING_THRESHOLD=400
SOP_CRITICAL_THRESHOLD=0.7
SOP_WARNING_THRESHOLD=0.8
MAX_EXPECTED_RUL=1000

# Data Configuration
MAX_FILE_SIZE=104857600  # 100MB in bytes
FEATURE_WINDOW_SIZE=10
OUTLIER_THRESHOLD=3.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_ROTATION=100 MB
LOG_RETENTION=30 days

# Cache Settings
ENABLE_CACHE=true
DEFAULT_CACHE_TTL=3600
PREDICTION_CACHE_TTL=1800
HEALTH_ANALYSIS_CACHE_TTL=300

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=8001
HEALTH_CHECK_INTERVAL=30

# Database (if using external database)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/battery_rul

# Redis (if using external Redis)
# REDIS_URL=redis://localhost:6379/0
# REDIS_MAX_CONNECTIONS=100